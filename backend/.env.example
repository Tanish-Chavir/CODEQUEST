# Port to run the server on
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/codequest

# JWT Secret Key for token generation/verification
JWT_SECRET=your_jwt_secret_key_here

# Gemini AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_FALLBACK=your_fallback_gemini_api_key_here

# ==========================================
# 📧 EMAIL SERVICE PROVIDER CONFIGURATIONS
# ==========================================
# Option 1: Gmail SMTP Setup (Easiest for testing with a real Gmail account)
# For EMAIL_PASS, generate an "App Password" from your Google account settings.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_google_app_password_16_chars

# Option 2: Resend API Setup (Highly recommended for high-volume SaaS applications)
# RESEND_API_KEY=re_123456789abcdef

# Option 3: SendGrid API Setup
# SENDGRID_API_KEY=SG.123456789abcdef

# Optional Custom Sender Email Address
EMAIL_FROM="CodeQuest" <noreply@codequest.app>
